{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2021",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "skipLibCheck": true,
        "strict": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "lib": ["ES2021"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
